# Совместить с ChatService: скопируйте JWT_SECRET_KEY из ChatService/.env
JWT_SECRET_KEY=

PORT=8480

# Локально без Postgres:
USE_SQLITE=true
SQLITE_PATH=./meet_service.db

# Или Postgres:
# USE_SQLITE=false
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/meet_service

# ICE для клиента (JSON-массив). Свой TURN подставьте в проде.
ICE_SERVERS_JSON=[{"urls":["stun:stun.l.google.com:19302"]}]

CORS_ORIGINS=*

# Пуши о звонке через ChatService (Novu). URL без слэша в конце — тот же хост:порт, что у Chat API.
# INTERNAL_DELIVERY_SECRET — скопируйте из ChatService/.env (тот же X-Internal-Secret, что для /api/internal/deliver).
CHAT_SERVICE_INTERNAL_BASE_URL=
INTERNAL_DELIVERY_SECRET=
